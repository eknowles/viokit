---
import { footer, site } from "../copy";
import Logo from "./Logo.astro";
---

<footer class="footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<Logo />
				<p>{footer.tagline}</p>
			</div>
			<div class="footer-col">
				<h4>{footer.explore.heading}</h4>
				<ul>
					{footer.explore.links.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>
			<div class="footer-col">
				<h4>{footer.contact.heading}</h4>
				<ul>
					{footer.contact.links.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>
		</div>
		<div class="footer-bottom">
			<span>© {new Date().getFullYear()} {site.name}. {footer.rights}</span>
			<span>{footer.bottomTagline}</span>
		</div>
	</div>
</footer>
