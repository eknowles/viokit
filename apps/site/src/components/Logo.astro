---
import { site } from "../copy";

interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a class="brand" href={href} aria-label={`${site.name} home`}>
	<span class="brand-mark" aria-hidden="true">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
			<circle cx="12" cy="12" r="3.2" fill="var(--accent)" />
			<circle cx="4.5" cy="5" r="1.7" fill="var(--info)" />
			<circle cx="19.5" cy="4.5" r="1.7" fill="var(--info)" />
			<circle cx="5" cy="19.5" r="1.7" fill="var(--info)" />
			<circle cx="19" cy="19" r="1.7" fill="var(--info)" />
			<path
				d="M6 6.5 10.6 10M18 6l-4.4 3.6M6 17.8 10.6 14M18 17.8 13.4 14"
				stroke="var(--info)"
				stroke-width="1.1"
				stroke-linecap="round"
			/>
		</svg>
	</span>
	<span>{site.name}</span>
</a>
