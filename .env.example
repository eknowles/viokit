# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must
# never hold a real value.
#
# Bun loads `.env` from the repo root automatically, so `devbox run api`,
# `bun packages/agent/src/cli.ts …`, and the tests all see these.
#
# Source credentials work by *reference* (TDR-018): a `SourceSpec` carries the
# NAME of the variable and how to apply it, never the value — packs are tracked
# source, so a spec that could hold a secret eventually would. The variable name
# below is what a spec's `auth.secretRef` points at.

# ─── Source credentials ───────────────────────────────────────────────────────
# See `openspec/exploration/05-source-access.md` for what each of these reaches,
# which endpoint was verified, and the free tier.

# header `APIKEY: <value>`
SECURITYTRAILS_API_KEY=

# Authorization: Bearer — free plan, 5 domains per page
HOSTIO_TOKEN=

# Authorization: Bearer — 500 queries free on signup
WHOISXML_API_KEY=

# Authorization: Bearer — personal access token; free tier is lookup only
CENSYS_PAT=

# Authorization: Bearer — blocked until a SourceSpec can express a POST
FULLCONTACT_API_KEY=

# ─── Deployment ───────────────────────────────────────────────────────────────

# Who may act. Empty means local single-user, and the HTTP surface then refuses
# to bind anywhere but loopback (TDR-023). Format: `token=id:Display Name`, one
# per line or separated by `;`.
# VIOKIT_PRINCIPALS="tok-ana=ana:Ana Ruiz;tok-bo=bo:Bo Chen"

# The credential the CLI and MCP present, where this deployment authenticates.
# VIOKIT_TOKEN=

# Signs evidentiary bundles (TDR-026). This is a *reference*: the value is the
# name of another variable holding a PKCS#8 Ed25519 PEM. Generate one with:
#   openssl genpkey -algorithm ed25519
# Multi-line values need quotes in a .env file.
# VIOKIT_SIGNING_KEY=BUNDLE_SIGNING_KEY
# BUNDLE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"

# ─── Storage ──────────────────────────────────────────────────────────────────
# All default to in-memory or `.viokit/`, which is gitignored. Set them to keep
# work between runs.

# VIOKIT_GRAPH_DB=.viokit/graph.db
# VIOKIT_EVIDENCE_DIR=.viokit/evidence
# VIOKIT_REDACTION_DIR=.viokit/redactions
# VIOKIT_VIEW_STATE_DIR=.viokit/view-state
# VIOKIT_CATALOG_DB=.viokit/catalog.db

# ─── HTTP surface ─────────────────────────────────────────────────────────────
# Binding beyond loopback is refused unless VIOKIT_PRINCIPALS is set.
# VIOKIT_HTTP_HOST=127.0.0.1
# VIOKIT_HTTP_PORT=4000

# ─── Browser transport ────────────────────────────────────────────────────────
# Auto-detected; set only if Chrome is somewhere unusual.
# BUN_CHROME_PATH=
