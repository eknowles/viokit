{
  "name": "labs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "astro:check": "bun run --filter @viokit/site astro check",
    "build": "bun run --filter @viokit/site build",
    "check": "ultracite check",
    "dev": "bun run --filter @viokit/site dev",
    "fix": "ultracite fix",
    "prepare": "./scripts/prepare-effect.sh; git rev-parse --is-inside-work-tree >/dev/null 2>&1 && lefthook install || echo 'not a git repo; skipping lefthook install' && effect-tsgo patch --typescript --no-oxlint",
    "preview": "bun run --filter @viokit/site preview",
    "test": "bun run --filter './packages/*' test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@effect/tsgo": "0.31.0",
    "@types/node": "^26.1.2",
    "bun": "1.4.0",
    "bun-types": "^1.3.14",
    "lefthook": "^2.1.10",
    "typescript": "7.0.2",
    "ultracite": "^7.10.0"
  }
}
